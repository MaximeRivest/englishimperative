#!/usr/bin/env bash
# ei — compile or run a .ei file (English statements, one per line).
#
#   ei compile FILE.ei [-o OUT]    translate to a script, print or write it
#   ei run FILE.ei                 translate, then execute
#
# File format:
#   @target python|bash    first non-comment line, default: bash
#   # comment              kept in the output script
#   line \                 continuation
set -euo pipefail

EI_URL="${EI_URL:-http://192.168.2.24:8000/v1/chat/completions}"
EI_KEY="${EI_KEY:-inktype-local}"
EI_MODEL="${EI_MODEL:-qwen/qwen3.8-27b}"

usage() { grep '^#   ' "$0" | sed 's/^#   //'; exit 1; }

translate() { # $1=target $2=code-so-far $3=statement
    local sys="You are a strict English-to-$1 interpreter. Translate the user's statement into $1 code. Output ONLY the code: no markdown fences, no comments, no explanation. The code is appended to the script shown in the context, so build on its state (variables, imports, directory)."
    local user="Script so far:
$2

Statement to translate: $3"
    jq -n --arg model "$EI_MODEL" --arg sys "$sys" --arg user "$user" \
        '{model:$model, temperature:0, max_tokens:800,
          messages:[{role:"system",content:$sys},{role:"user",content:$user}]}' \
    | curl -s --max-time 120 "$EI_URL" \
        -H "Authorization: Bearer $EI_KEY" \
        -H "Content-Type: application/json" \
        -d @- \
    | jq -r '.choices[0].message.content // empty' \
    | sed -e 's/^```[a-z]*$//' -e 's/^```$//'
}

compile() { # $1=file  -> prints script on stdout
    local file="$1" target=bash code="" line statement=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^@target[[:space:]]+(python|bash)$ ]]; then
            target="${BASH_REMATCH[1]}"; continue
        fi
        if [[ "$line" =~ ^[[:space:]]*# || -z "${line// /}" ]]; then
            [[ -n "$line" ]] && code+="$line"$'\n'
            continue
        fi
        if [[ "$line" == *'\' ]]; then
            statement+="${line%\\} "; continue
        fi
        statement+="$line"
        echo "ei: $statement" >&2
        local block
        block=$(translate "$target" "$code" "$statement")
        [[ -z "$block" ]] && { echo "ei: translation failed: $statement" >&2; exit 1; }
        code+="# $statement"$'\n'"$block"$'\n\n'
        statement=""
    done < "$file"
    local shebang="#!/usr/bin/env bash"
    [[ "$target" == python ]] && shebang="#!/usr/bin/env python3"
    printf '%s\n# generated by ei from %s\n\n%s' "$shebang" "$file" "$code"
    echo "__EI_TARGET__=$target" >/dev/null
    EI_TARGET="$target"
}

cmd="${1:-}"; file="${2:-}"
[[ -z "$cmd" || -z "$file" ]] && usage
[[ ! -f "$file" ]] && { echo "ei: no such file: $file" >&2; exit 1; }

case "$cmd" in
    compile)
        out=""
        [[ "${3:-}" == "-o" && -n "${4:-}" ]] && out="$4"
        if [[ -n "$out" ]]; then
            compile "$file" > "$out"
            chmod +x "$out"
            echo "ei: wrote $out" >&2
        else
            compile "$file"
        fi
        ;;
    run)
        tmp=$(mktemp /tmp/ei-run.XXXXXX)
        trap 'rm -f "$tmp"' EXIT
        EI_TARGET=""
        compile "$file" > "$tmp"
        if head -1 "$tmp" | grep -q python; then
            python3 "$tmp"
        else
            bash "$tmp"
        fi
        ;;
    *) usage ;;
esac
